# ═══════════════════════════════════════════════════
# AXIOM v2.0 — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ═══════════════════════════════════════════════════

# ─── OBLIGATOIRE ───────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ─── TELEGRAM (Module 1 — Bot & Alertes) ──────────
# Créer via @BotFather sur Telegram : /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Récupérer via @userinfobot sur Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Activer le polling Telegram (pour commandes /trades, /status, /stop)
# Mettre à "true" en production si un seul serveur
TELEGRAM_POLLING=false

# ─── SÉCURITÉ ──────────────────────────────────────
# Clé secrète pour les routes admin (/api/scan-manual, /api/analytics/snapshot)
ADMIN_KEY=your_secret_admin_key_here

# Origines autorisées pour CORS (séparées par virgule)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# ─── TRADING ───────────────────────────────────────
# Capital initial en euros (utilisé pour les calculs de risque et le dashboard)
CAPITAL_INITIAL=5000

# ─── SERVEUR ───────────────────────────────────────
PORT=3001
NODE_ENV=production
